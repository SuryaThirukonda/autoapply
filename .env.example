# goat configuration. Fill in during testing. Never commit this file (it is gitignored).

# ---- OpenAI (Responses API) ----
OPENAI_API_KEY=
EXECUTOR_MODEL=gpt-6-luna
EXECUTOR_EFFORT=low
EXECUTOR_RETRY_EFFORT=medium
ADVISOR_MODEL=gpt-6-luna
ADVISOR_EFFORT=medium
ADVISOR_MAX_CALLS=3
CLASSIFIER_MODEL=gpt-6-luna
CLASSIFIER_EFFORT=none
CLASSIFIER_MIN_CONFIDENCE=0.85
# default | flex  (flex auto-falls back to default on 429/503)
OPENAI_SERVICE_TIER=default
SAFETY_IDENTIFIER_SALT=change-me

# ---- Run mode ----
# shadow = fill everything, run the gate, stop before the final click (start here).
# live   = submit when the gate passes, only on portals listed in LIVE_PORTALS.
GOAT_MODE=shadow
LIVE_PORTALS=
SIMPLIFY_PREFILL=false
LOG_LEVEL=INFO

# ---- Budgets ----
BUDGET_STEPS=120
BUDGET_FAILED_SUBMITS=2
BUDGET_MAX_ATTEMPTS=3
ANSWER_WAIT_S=900
CODE_WAIT_S=180
MAX_HELD_TABS=4

# ---- Dedicated Chrome profile (NOT the default profile; Chrome 136+ refuses CDP there) ----
# Empty = the platform default: Chrome stable on Windows/macOS; google-chrome or chromium on Linux.
CHROME_EXE=
CHROME_USER_DATA_DIR=C:\Users\Surya\Documents\bub\chrome-profile
# 9222 is still held by the old Hermes Chrome; use 9223 or stop that Chrome and reuse its profile.
CDP_PORT=9223
CHROME_LAUNCH_IF_MISSING=true
VIEWPORT_W=1440
VIEWPORT_H=900
# original | auto | (empty to omit; the harness drops the field automatically if the API rejects it)
SCREENSHOT_DETAIL=original

# ---- Telegram ----
# With the cloud link on (GOAT_DB_URL below) goat does not run this bot itself: the Telegram worker on the
# website's server uses these two values (copied there by goat-dashboard/deploy/aws/release.sh).
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=0

# ---- Cloud link (RDS) ----
# The goat_agent role's RDS Postgres URL, written by goat-dashboard/scripts/db-roles.mjs (deploy/aws/up.sh).
# Set = goat mirrors its state to RDS and takes answers, listings and controls from the website and Telegram.
# Empty = local only. RDS is the only link to AWS; the agent never needs other AWS access.
GOAT_DB_URL=
GOAT_AGENT_NAME=cadoganpc

# ---- Gmail API (read-only; OAuth client must be in Production, not Testing) ----
GMAIL_CREDENTIALS_JSON=C:\Users\Surya\Documents\bub\secrets\gmail_client.json
GMAIL_TOKEN_JSON=C:\Users\Surya\Documents\bub\secrets\gmail_token.json
APPLICATION_EMAIL=you@example.com
MAIL_POLL_S=4

# ---- Bitwarden CLI (a separate vault holding only portal credentials) ----
BW_EXE=bw
BW_SESSION=
# optional: path to a file holding the master password, used only by `bw unlock --passwordfile`
BW_PASSWORDFILE=
# Unattended unlock: a personal API key from the web vault (Settings > Security > Keys > API key).
# goat runs `bw login --apikey` when the CLI is logged out, then unlocks with BW_PASSWORDFILE, and
# unlocks again by itself whenever a bw call finds the vault locked.
BW_CLIENTID=
BW_CLIENTSECRET=
# only for a non-default server, e.g. https://vault.bitwarden.eu
BW_SERVER=

# ---- Health and backups ----
# /healthz fails after this many seconds without an event (0 = never on age alone)
HEALTH_MAX_EVENT_AGE_S=0
# optional: hand each nightly backup to an uploader that exists where scripts/backup_db.py runs ({file} =
# the backup path).
BACKUP_UPLOAD_CMD=

# ---- Paths ----
GOAT_DB=C:\Users\Surya\Documents\bub\data\goat.db
RECORDS_DIR=C:\Users\Surya\Documents\bub\records
PROPOSALS_DIR=C:\Users\Surya\Documents\bub\proposals
RESUME_DIR=C:\Users\Surya\Documents\bub\resumes
SCRAPE_INTERVAL_S=900

# Lanes the worker may claim: no_account (Greenhouse, Ashby), ready_for_you (Lever), account (Workday/Oracle/iCIMS; needs Bitwarden + Gmail)
LANES_ENABLED=no_account,ready_for_you

# Dashboard (http://127.0.0.1:<port>, also started by `goat run`)
DASHBOARD_PORT=8787

# Hard allowlist enforced in code: any other model name is refused before a request is sent.
ALLOWED_MODELS=gpt-6-luna
