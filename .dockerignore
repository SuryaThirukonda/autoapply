# The image holds code only. This repository is public and an image can end up in a registry, so
# nothing personal or secret goes in: those are bind mounts (docker-compose.yml). Mirrors .gitignore;
# Docker matches patterns from the context root, so globs carry **/ to match at any depth.

# secrets
.env
.env.*
!.env.example
secrets
**/*.pem
**/*.key
**/*token*.json
**/*client_secret*.json

# personal data (config/LOCAL_FILES.md)
config/profile.md
config/questionnaire.yaml
config/standing_answers.json
config/surya_facts.md
config/answer_bank.json
config/delegation.yaml
config/guardrails.md
resumes
transcripts

# runtime state
data
**/*.db
**/*.db-wal
**/*.db-shm
**/*.bak-*
records
chrome-profile
logs
**/*.log
proposals

# tooling and the Windows desktop shell
.git
.venv
**/__pycache__
**/*.pyc
.pytest_cache
**/node_modules
app
.claude
**/.DS_Store
**/Thumbs.db
